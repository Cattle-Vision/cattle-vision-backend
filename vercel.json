{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npx prisma generate",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{identifier.onnx,models/*.onnx,prisma/schema.prisma,node_modules/.prisma/**,node_modules/@prisma/client/**,node_modules/onnxruntime-node/bin/napi-v6/linux/x64/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
