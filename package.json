{
  "name": "cattle-vision-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API RESTful NestJS, Inferência IA YOLOv8 ONNX e Gestão Zootécnica/ICS Bovino",
  "scripts": {
    "dev": "node scripts/with-env.js nest start --watch",
    "dev:safe": "node scripts/safe-start.js --dev",
    "start:dev": "node scripts/with-env.js nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node scripts/with-env.js node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:safe": "node scripts/safe-start.js",
    "typecheck": "tsc --noEmit",
    "db:status": "node scripts/with-env.js npx prisma migrate status",
    "db:migrate": "node scripts/with-env.js npx prisma migrate deploy",
    "db:migrate:dev": "node scripts/migrate-dev-safe.js",
    "db:migrate:deploy": "node scripts/db-backup.js --best-effort && node scripts/with-env.js npx prisma migrate deploy",
    "db:backup": "node scripts/db-backup.js",
    "db:check": "node scripts/check-migrations.js --with-db",
    "prepare": "node -e \"if(require('fs').existsSync('.git')) require('child_process').execSync('husky',{stdio:'inherit'})\"",
    "seed": "node scripts/with-env.js npx tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "onnxruntime-node": "^1.30.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/adm-zip": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^20",
    "husky": "^9.1.7",
    "typescript": "^5"
  }
}
