# ============================================================================
# CattleVision Backend — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env no backend e configure conforme seu ambiente.
# ============================================================================

# Porta do Servidor HTTP
PORT="3001"

# ── Configuração de CORS para Multi-PC / Multi-Servidor / Multi-Projeto ──────
# Especifique "*" para aceitar requisições de qualquer origem (ideal para desenvolvimento
# ou dispositivos móveis em IPs dinâmicos), ou liste as origens permitidas separadas por vírgula:
# Ex: CORS_ORIGIN="http://localhost:3000,http://192.168.1.50:3000,https://seu-frontend.vercel.app"
CORS_ORIGIN="*"

# ── Chave Secreta JWT para Autenticação Desacoplada ─────────────────────────
AUTH_SECRET="cattle-vision-super-secret-jwt-key-2026-production"

# ── Credenciais de Administrador Padrão ─────────────────────────────────────
ADMIN_EMAIL="admin@cattlecapture.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador CattleVision"

# ── Banco de Dados PostgreSQL (Neon / Supabase / Docker / Local) ────────────
DATA_POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/cattle_capture?schema=public"
DATA_POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/cattle_capture?schema=public"

# ── Armazenamento de Fotos (Vercel Blob Storage ou Fallback PostgreSQL) ─────
# Se configurado, fotos são salvas no Vercel Blob.
# Se ausente, as fotos são salvas de forma resiliente em Base64 inline no PostgreSQL.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Dimensão máxima da inferência dinâmica YOLO (padrão: 640)
AI_INFERENCE_MAX_DIM="640"
